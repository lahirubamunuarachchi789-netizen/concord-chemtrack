# ============================================================
#  Concord ChemTrack - secrets template
# ------------------------------------------------------------
#  1. Copy this file to:      .streamlit/secrets.toml
#  2. Paste your Supabase credentials below
#  3. NEVER commit secrets.toml (it is listed in .gitignore)
#
#  Supabase Dashboard -> Project Settings -> API
#    Project URL   -> SUPABASE_URL
#    API key       -> SUPABASE_KEY  (use the "service_role" key only
#                     on a trusted internal server; otherwise "anon")
# ============================================================

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY"
